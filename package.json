{
  "name": "hailite-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "build:vercel": "npm run typecheck && vite build",
    "build:trial": "npm run typecheck && vite build --mode trial --outDir dist-trial && node scripts/assert-trial-build.mjs dist-trial && vite build --mode trial && node scripts/assert-trial-build.mjs dist && cap sync android",
    "android:trial-apk": "npm run build:trial && cd android && ./gradlew assembleDebug",
    "build:mobile": "npm run typecheck && vite build --mode mobile && cap sync android",
    "android:sync": "npm run build:mobile",
    "android:open": "cap open android",
    "android:apk": "npm run build:mobile && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build:mobile && cd android && ./gradlew bundleRelease",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "test:trial": "node scripts/test-trial-mode.mjs",
    "test:offline": "node scripts/test-offline-mode.mjs",
    "store:validate": "node --import tsx scripts/validate-store-readiness.ts",
    "start": "node dist/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:features": "node --import tsx scripts/validate-all.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@google/genai": "^2.16.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.0.5",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.0.1",
    "vite": "^8.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.66.0"
  }
}
