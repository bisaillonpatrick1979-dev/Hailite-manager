{
  "name": "react-example",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "build:vercel": "npm run typecheck && vite build",
    "start": "node dist/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.2.3"
  }
}
