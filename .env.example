# Serveur / URL canonique
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Supabase — variables strictement serveur; ne jamais utiliser le préfixe VITE_
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Facultatif avec une seule compagnie; obligatoire avec plusieurs compagnies.
DEFAULT_COMPANY_ID=""
SUPABASE_PROJECT_MEDIA_BUCKET="project-media"

# Secret HMAC stable d'au moins 32 caractères pour les cookies de session.
# Exemple de génération : openssl rand -base64 48
SESSION_SECRET=""

# Fournisseurs IA côté serveur (configurer seulement ceux qui sont utilisés)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Jeu fictif local — pris en compte uniquement par `vite` en développement
VITE_LOCAL_TEST_MODE="false"
